# Database Configuration
DATABASE_URL=postgresql://postgres:postgres_db_metal_health_care@localhost:5432/mental_care_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_db_metal_health_care
POSTGRES_DB=mental_care_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production-min-32-characters
DEBUG=True

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google AI (Gemini) Configuration
GOOGLE_API_KEY=your-google-ai-api-key

# AI Model API (Your FastAPI Model)
AI_MODEL_URL=https://your-ngrok-url.ngrok-free.dev
AI_MODEL_TIMEOUT=30

# MongoDB Atlas Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGO_DB_NAME=mental_health_chat

# File Upload
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379/0

# Admin Configuration
ADMIN_EMAIL=admin@mindcare.ai
ADMIN_PASSWORD=Admin@123456

# Application Settings
APP_NAME=MindCare AI
APP_URL=http://localhost:5173
API_VERSION=v1

# ========================================
# PAYMENT GATEWAY CONFIGURATION
# ========================================

# VNPay Configuration
# Get credentials from: https://sandbox.vnpayment.vn
VNPAY_TMN_CODE=your_vnpay_merchant_code_here
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo QR Payment Configuration
# Get credentials from: https://developers.momo.vn
MOMO_PARTNER_CODE=your_momo_partner_code_here
MOMO_ACCESS_KEY=your_momo_access_key_here
MOMO_SECRET_KEY=your_momo_secret_key_here
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PUBLIC_KEY_PATH=certs/momo_public_key.pem

# ZaloPay Configuration
# Get credentials from: https://docs.zalopay.vn
ZALOPAY_APP_ID=your_zalopay_app_id_here
ZALOPAY_KEY1=your_zalopay_key1_here
ZALOPAY_KEY2=your_zalopay_key2_here
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
